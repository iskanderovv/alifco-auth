// Paste into https://dbdiagram.io/d  (left editor)

Project oauth_service {
  database_type: 'PostgreSQL'
  Note: 'OAuth login service: Google, Facebook, Telegram'
}

Enum oauth_provider {
  google
  facebook
  telegram
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(320) [unique, null, note: 'null for Telegram/Facebook users without email. Lowercased.']
  email_verified boolean [not null, default: false]
  name varchar(255) [not null]
  avatar_url text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'One row per person. Owned by this service.'
}

Table oauth_identities {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  provider oauth_provider [not null]
  provider_user_id varchar(255) [not null, note: 'Google sub / Facebook id / Telegram id']
  email varchar(320) [null, note: 'email as reported by provider at last login']
  created_at timestamptz [not null, default: `now()`]
  last_login_at timestamptz [null]

  indexes {
    (provider, provider_user_id) [unique, name: 'uq_identity_provider_subject']
    (user_id, provider) [unique, name: 'uq_identity_user_provider', note: 'one identity per provider per user']
    user_id
  }

  Note: 'A user can have many identities (max one per provider).'
}

Table refresh_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  family_id uuid [not null, note: 'all rotations of one login share a family']
  token_hash char(64) [not null, unique, note: 'SHA-256 hex of the token. Raw token is never stored.']
  expires_at timestamptz [not null]
  revoked_at timestamptz [null]
  replaced_by uuid [null, ref: > refresh_tokens.id, note: 'set on rotation']
  user_agent text [null]
  ip inet [null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    family_id
    expires_at
  }

  Note: 'Rotation: each refresh revokes the old row and creates a new one in the same family. Reuse of a revoked token revokes the whole family.'
}
