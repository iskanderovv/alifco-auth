generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OAuthProvider {
  google
  facebook
  telegram

  @@map("oauth_provider")
}

enum OAuthMode {
  login
  link

  @@map("oauth_mode")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Only set when the provider verified it. Never used to match accounts.
  email     String?  @db.VarChar(320)
  name      String   @db.VarChar(255)
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities        OAuthIdentity[]
  refreshTokens     RefreshToken[]
  oauthTransactions OAuthTransaction[]

  @@map("users")
}

model OAuthIdentity {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id") @db.VarChar(255)
  email          String?       @db.VarChar(320)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt    DateTime?     @map("last_login_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], map: "uq_identity_provider_subject")
  @@unique([userId, provider], map: "uq_identity_user_provider")
  @@map("oauth_identities")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Rotations of one login share a family; reuse revokes it.
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent")
  ip        String?   @db.Inet
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OAuthTransaction {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stateHash    String        @unique @map("state_hash") @db.Char(64)
  codeVerifier String        @map("code_verifier") @db.VarChar(128)
  provider     OAuthProvider
  mode         OAuthMode     @default(login)
  userId       String?       @map("user_id") @db.Uuid
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime?     @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_transactions")
}
