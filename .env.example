NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://oauth:oauth@localhost:5432/oauth

# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_ISSUER=oauth-service
JWT_AUDIENCE=oauth-service-api
REFRESH_TTL_DAYS=30

# Generate with: openssl rand -base64 32
COOKIE_SECRET=
COOKIE_SECURE=false
# lax | none (none only with HTTPS tunnel testing, requires COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax

# A provider is enabled only when all of its variables are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

LOG_LEVEL=info
HTTP_TIMEOUT_MS=5000
BODY_LIMIT_BYTES=10240
